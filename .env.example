# Salin file ini menjadi .env.local lalu isi nilainya dari dashboard Supabase:
# Project Settings > API Keys (atau Settings > API).
# .env.local TIDAK ikut tersimpan ke git, jadi aman untuk kunci Anda.

# Alamat proyek Supabase, contoh: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci PUBLIK: "publishable key" (diawali sb_publishable_) atau "anon public key".
# JANGAN isi dengan "secret key" / "service_role key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
